# Copy to .env and fill in real values. .env is gitignored.
FASTAPI_ENV=development
PROJECT_NAME="EZ-10k: Agentic DCF"

# Local dev ports. These are also the hardcoded defaults in the code (fastapi dev
# and vite.config.ts), so a fresh clone with no .env still lands on 8000/5173.
# Bump both per worktree so several can run side by side.
# PORT is read directly by `fastapi dev`; vite reads FRONTEND_PORT.
PORT=8000
FRONTEND_PORT=5173

# LLM (OpenAI-compatible LiteLLM proxy)
OPENAI_API_KEY=changethis
OPENAI_BASE_URL=https://parsity-litellm.fly.dev
LLM_MODEL=gpt-6-luna

# SEC EDGAR requires a descriptive User-Agent with contact information.
SEC_USER_AGENT="EZ-10k Capstone (you@example.com)"

# FRED (St. Louis Fed) macro series: 10Y yield, CPI, real GDP.
# This app owns the key and forwards it to the fred-mcp-server child process.
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=changethis
# The MCP server runs as a long-lived sidecar (`./scripts/dev-mcp.sh`) so its
# response cache and rate limiter survive between turns. One URL per worktree.
FRED_MCP_PORT=3101
FRED_MCP_URL=http://127.0.0.1:3101/mcp
FRED_CACHE_TTL_MS=21600000
# Optional: disable the chat's FRED tools, or pin an MCP server version.
# FRED_MCP_ENABLED=true
# FRED_MCP_PACKAGE=fred-mcp-server
# Set to "stdio" to spawn the server per call again (slow, no shared cache).
# FRED_MCP_TRANSPORT=http
